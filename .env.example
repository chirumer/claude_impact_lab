# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Anthropic has no embeddings API — Voyage AI is Anthropic's recommended
# embeddings partner. Get a key from https://dashboard.voyageai.com/
VOYAGEAI_API_KEY=

# Optional tuning
CLAUDE_CHAT_MODEL=claude-haiku-4-5
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
SIMILARITY_THRESHOLD=0.75
